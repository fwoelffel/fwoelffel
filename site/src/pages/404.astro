---
import Base from '../layouts/Base.astro';
import { identity } from '../config';
---

<Base
  title={`Page introuvable · ${identity.fullName}`}
  description='Cette page n’existe pas.'
  noindex>
  <main>
    <p class='code'>404</p>
    <h1>Cette carte n’est pas dans le paquet.</h1>
    <a href='/'>Retour à la carte</a>
  </main>
</Base>

<style>
  main {
    position: relative;
    min-height: 100%;
    display: grid;
    place-content: center;
    gap: 1rem;
    padding: 1.5rem;
    text-align: center;
  }

  .code {
    margin: 0;
    font: 700 clamp(5rem, 28vw, 10rem) / 0.9 var(--display);
    background: linear-gradient(#b8860b, #7a5a12);
    background-clip: text;
    color: transparent;
  }

  @media (prefers-color-scheme: dark) {
    .code {
      background: linear-gradient(#fff3c2, #e9b93f);
    }
  }

  h1 {
    margin: 0;
    font: 600 clamp(1.1rem, 4vw, 1.5rem) var(--body);
  }

  a {
    justify-self: center;
    padding: 0.6rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: inherit;
    text-decoration: none;
  }
</style>
