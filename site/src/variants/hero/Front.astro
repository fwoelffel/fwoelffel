---
import Foil from '../../components/card/Foil.astro';
import Frame from '../../components/card/Frame.astro';
import Links from '../../components/card/Links.astro';
import Portrait from '../../components/card/Portrait.astro';
import { identity } from '../../config';
import { madeUp, type FrontProps } from '../types';
import hero from './index';
import './theme.css';

type Props = FrontProps;
const { number, eager } = Astro.props;
---

<Frame>
  <div class='inner'>
    <b class='cost' aria-hidden='true'>
      {hero.cost}
    </b>
    <div class='art'>
      <Portrait class='photo' sizes='15rem' eager={eager} />
    </div>
    <h1 class='banner'>
      {identity.fullName}
      <i class='rarity' aria-hidden='true'></i>
    </h1>
    <p class='sr-only'>
      Coût {hero.cost}, attaque {hero.attack}, santé {hero.health}, rareté
      {hero.rarity} {madeUp}
    </p>
    <div class='text'>
      <p class='keyword'>
        <b>{hero.keyword.name}</b> : {hero.keyword.text}
      </p>
      <Links class='abilities' />
    </div>
    <div class='foot' aria-hidden='true'>
      <span class='stat attack'>
        <svg viewBox='0 0 16 16'>
          <path d='M14 2 5.5 10.5M2.5 8.5l5 5M4 12l-2 2M14 2l-3.2.6M14 2l-.6 3.2'></path>
        </svg>
        <b>{hero.attack}</b>
      </span>
      <p>
        {identity.role}
        <small>
          {number} · {identity.host}
        </small>
      </p>
      <span class='stat health'>
        <svg viewBox='0 0 16 16'>
          <path d='M8 14S1.5 10.2 1.5 5.7a3.2 3.2 0 0 1 6.5-1.5 3.2 3.2 0 0 1 6.5 1.5C14.5 10.2 8 14 8 14Z'></path>
        </svg>
        <b>{hero.health}</b>
      </span>
    </div>
  </div>
  <Foil sweep />
</Frame>

<style>
  /* Ornate gold border around a dark stone field. */
  .inner {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.3em;
    padding: 0.5em 0.55em 0.3em;
    border: 0.35em solid transparent;
    border-radius: 0.9em;
    background:
      var(--hero-stone) padding-box,
      var(--hero-gold) border-box;
    box-shadow: inset 0 0 0 0.08em #5a3a0c;
  }

  p,
  h1 {
    margin: 0;
  }

  /* Cost crystal: a faceted hexagon. Sizes in its own em (1.6x). */
  .cost {
    position: absolute;
    top: 0.25em;
    left: 0.25em;
    z-index: 1;
    width: 1.55em;
    height: 1.8em;
    display: grid;
    place-items: center;
    font: 700 1.6em/1 var(--display);
    color: #fff;
    -webkit-text-stroke: 0.07em #0e1c5c;
    paint-order: stroke fill;
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    background:
      repeating-conic-gradient(
        rgb(255 255 255 / 0.2) 0 60deg,
        rgb(0 0 0 / 0.15) 60deg 120deg
      ),
      linear-gradient(160deg, #c4ecff, #3d8bff 45%, #1a2f9c);
  }

  /* Oval window. */
  .art {
    position: relative;
    flex: 1 1 0;
    min-height: 4em;
    width: 74%;
    align-self: center;
    overflow: hidden;
    border: 0.22em solid var(--hero-gold-line);
    border-radius: 50%;
    box-shadow:
      0 0 0 0.08em #5a3a0c,
      0 0 1em rgb(255 200 110 / 0.35);
  }

  .photo {
    position: absolute;
    inset: 0;
    --portrait-w: 100%;
    --portrait-h: 100%;
  }

  /* Name banner: a notched ribbon (gold edge, then wood) over the
     window's bottom, the rarity gem hanging from its middle. */
  .banner {
    margin: -1.5em -0.1em 0;
    padding: 0.25em 1.3em 0.35em;
    text-align: center;
    font: 700 1.25em/1.1 var(--display);
    letter-spacing: 0.03em;
    color: #fff3d0;
    text-shadow: 0 0.06em 0.1em rgb(0 0 0 / 0.7);
  }

  .banner::before,
  .banner::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    clip-path: polygon(0 0, 100% 0, 94% 50%, 100% 100%, 0 100%, 6% 50%);
    background: var(--hero-gold);
  }

  .banner::after {
    inset: 0.1em 0.15em;
    background: linear-gradient(#7d4b1d, #3f220a);
  }

  .rarity {
    position: absolute;
    left: 50%;
    bottom: -0.4em;
    width: 0.6em;
    height: 0.6em;
    translate: -50% 0;
    rotate: 45deg;
    border: 0.08em solid #fff1b8;
    background: linear-gradient(135deg, #ffd27a, #ff7b1c 55%, #a83a00);
    box-shadow: 0 0 0.5em #ff9a3d;
  }

  .text {
    flex: none;
    padding: 0.55em 0.5em 0.9em;
    border-radius: 0.5em;
    background: linear-gradient(#f7e9c8, #dcc493);
    box-shadow:
      0 0 0 0.12em var(--hero-gold-line),
      inset 0 0 0.6em rgb(120 80 20 / 0.4);
  }

  .keyword {
    text-align: center;
    font-size: 0.85em;
    line-height: 1.2;
  }

  .keyword b {
    font: 700 1.15em var(--display);
    letter-spacing: 0.03em;
  }

  /* The links read as card text: "[icon] GitHub : Mon code." */
  .abilities :global(a > span:first-of-type) {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.35em;
  }

  .abilities :global(b) {
    text-transform: none;
  }

  .abilities :global(b)::after {
    content: ' :' / '';
  }

  .abilities :global(small) {
    font-size: 0.85em;
    opacity: 1;
  }

  .abilities :global(small)::after {
    content: '.' / '';
  }

  .foot {
    display: flex;
    align-items: flex-end;
    margin: -1em -0.35em 0;
  }

  .foot p {
    flex: 1;
    display: flex;
    flex-direction: column;
    text-align: center;
    font: 600 0.6em/1.25 var(--display);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--hero-gold-line);
  }

  .foot small {
    font-size: 0.9em;
    opacity: 0.8;
  }

  /* Stat medallions. Sizes in their own em (1.7x). */
  .stat {
    display: grid;
    place-items: center;
    width: 1.65em;
    height: 1.65em;
    font: 700 1.7em/1 var(--display);
    color: #fff;
    -webkit-text-stroke: 0.07em #2b1306;
    paint-order: stroke fill;
    box-shadow:
      0 0 0 0.06em var(--hero-gold-line),
      0 0.08em 0.2em rgb(0 0 0 / 0.55);
  }

  .stat > * {
    grid-area: 1 / 1;
  }

  .stat svg {
    width: 72%;
    height: 72%;
  }

  .attack {
    border-radius: 50%;
    background: radial-gradient(
      circle at 35% 30%,
      #ffe08a,
      #d98a1c 60%,
      #7a4210
    );
  }

  .attack svg {
    fill: none;
    stroke: rgb(80 35 0 / 0.5);
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .health {
    border-radius: 0.25em 0.25em 50% 50% / 0.25em 0.25em 60% 60%;
    background: radial-gradient(
      circle at 35% 30%,
      #ff9a8a,
      #d0302a 60%,
      #6e0e12
    );
  }

  .health svg {
    fill: rgb(255 255 255 / 0.3);
  }

  /* Text above the foil so the hotspot never washes it out. */
  .banner,
  .text,
  .foot {
    position: relative;
    z-index: 1;
  }
</style>
