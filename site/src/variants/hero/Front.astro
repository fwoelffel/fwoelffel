---
import Foil from '../../components/card/Foil.astro';
import Frame from '../../components/card/Frame.astro';
import Links from '../../components/card/Links.astro';
import Portrait from '../../components/card/Portrait.astro';
import { identity } from '../../config';
import { madeUp, type FrontProps } from '../types';
import hero from './index';
import './theme.css';

type Props = FrontProps;
const { number, eager } = Astro.props;
const stats = [
  { name: 'cost', value: hero.cost, icon: 'M8 1.5 14 6l-6 8.5L2 6Z' },
  {
    name: 'attack',
    value: hero.attack,
    icon: 'M14 2 5.5 10.5M2.5 8.5l5 5M4 12l-2 2M14 2l-3.2.6M14 2l-.6 3.2',
  },
  {
    name: 'health',
    value: hero.health,
    icon: 'M8 14S1.5 10.2 1.5 5.7a3.2 3.2 0 0 1 6.5-1.5 3.2 3.2 0 0 1 6.5 1.5C14.5 10.2 8 14 8 14Z',
  },
];
---

<Frame>
  <div class='inner'>
    <div class='art'>
      <Portrait class='photo' sizes='15rem' eager={eager} />
    </div>
    <h1 class='banner'>{identity.fullName}</h1>
    <div class='text'>
      <p class='keyword'>
        <b>{hero.keyword.name}</b> : {hero.keyword.text}
      </p>
      <Links class='abilities' inline />
    </div>
    <div class='foot'>
      <p class='stats'>
        <span class='sr-only'>
          {`Coût ${hero.cost}, attaque ${hero.attack}, santé ${hero.health} ${madeUp}`}
        </span>
        {stats.map(({ name, value, icon }) => (
          <b class={name} aria-hidden='true'>
            <svg viewBox='0 0 16 16'>
              <path d={icon}></path>
            </svg>
            {value}
          </b>
        ))}
      </p>
      <p class='role'>
        {identity.role}
        <small aria-hidden='true'>
          {number} · {identity.host}
        </small>
      </p>
    </div>
  </div>
  <Foil sweep />
</Frame>

<style>
  /* Ornate gold border around a dark stone field. */
  .inner {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.3em;
    padding: 0.5em 0.55em 0.35em;
    border: 0.35em solid transparent;
    border-radius: 0.9em;
    background:
      var(--hero-stone) padding-box,
      var(--hero-gold) border-box;
    box-shadow: inset 0 0 0 0.08em #5a3a0c;
  }

  p,
  h1 {
    margin: 0;
  }

  /* Arched window. */
  .art {
    position: relative;
    flex: 1 1 0;
    min-height: 4em;
    width: 80%;
    align-self: center;
    overflow: hidden;
    border: 0.22em solid var(--hero-gold-line);
    border-radius: 50% 50% 0.5em 0.5em / 35% 35% 0.5em 0.5em;
    box-shadow:
      0 0 0 0.08em #5a3a0c,
      0 0 1em rgb(255 200 110 / 0.35);
  }

  .photo {
    position: absolute;
    inset: 0;
    --portrait-w: 100%;
    --portrait-h: 100%;
  }

  /* Name ribbon: notched, gold edge, then wood, tucked under the window. */
  .banner {
    margin: -0.8em -0.1em 0;
    padding: 0.25em 1.3em 0.35em;
    text-align: center;
    font: 700 1.25em/1.1 var(--display);
    letter-spacing: 0.03em;
    color: #fff3d0;
    text-shadow: 0 0.06em 0.1em rgb(0 0 0 / 0.7);
  }

  .banner::before,
  .banner::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    clip-path: polygon(0 0, 100% 0, 94% 50%, 100% 100%, 0 100%, 6% 50%);
    background: var(--hero-gold);
  }

  .banner::after {
    inset: 0.1em 0.15em;
    background: linear-gradient(#7d4b1d, #3f220a);
  }

  .text {
    flex: none;
    padding: 0.55em 0.5em;
    border-radius: 0.5em;
    background: linear-gradient(#f7e9c8, #dcc493);
    box-shadow:
      0 0 0 0.12em var(--hero-gold-line),
      inset 0 0 0.6em rgb(120 80 20 / 0.4);
  }

  .keyword {
    text-align: center;
    font-size: 0.85em;
    line-height: 1.2;
  }

  .keyword b {
    font: 700 1.15em var(--display);
    letter-spacing: 0.03em;
  }

  /* The links read as card text: "[icon] GitHub : Mon code." */
  .abilities :global(small) {
    font-size: 0.85em;
  }

  .foot {
    display: flex;
    align-items: center;
    gap: 0.5em;
  }

  /* Cost, attack and health: gem-coloured badges, gold rimmed. */
  .stats {
    display: flex;
    gap: 0.3em;
  }

  .stats b {
    display: flex;
    align-items: center;
    gap: 0.15em;
    padding: 0.12em 0.4em 0.12em 0.3em;
    border-radius: 1em;
    font: 700 1.05em/1 var(--display);
    color: #fff;
    box-shadow:
      0 0 0 0.08em var(--hero-gold-line),
      0 0.06em 0.15em rgb(0 0 0 / 0.5);
  }

  .stats svg {
    width: 0.85em;
    height: 0.85em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cost {
    background: linear-gradient(#8a63e0, #4c2a9c);
  }

  .attack {
    background: linear-gradient(#c88418, #8a4f06);
  }

  .health {
    background: linear-gradient(#d8453c, #8e1a1f);
  }

  .role {
    flex: 1;
    display: flex;
    flex-direction: column;
    text-align: right;
    font: 600 0.6em/1.25 var(--display);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--hero-gold-line);
  }

  .role small {
    font-size: 0.9em;
    opacity: 0.8;
  }

  /* Text above the foil so the hotspot never washes it out. */
  .banner,
  .text,
  .foot {
    position: relative;
    z-index: 1;
  }
</style>
