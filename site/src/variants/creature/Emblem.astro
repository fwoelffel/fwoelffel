---
/**
 * The creature's original "Code" element: a hexagon holding two chevrons.
 * Decorative. 1em square (size it with font-size), coloured by
 * --creature-element and --creature-element-edge.
 */
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'svg'>;

const { class: className, ...rest } = Astro.props;
---

<svg
  class:list={['emblem', className]}
  viewBox='0 0 24 24'
  aria-hidden='true'
  {...rest}>
  <polygon points='12 1.5 21.5 7 21.5 17 12 22.5 2.5 17 2.5 7'></polygon>
  <path d='M9.6 8.4 6 12l3.6 3.6M14.4 8.4 18 12l-3.6 3.6'></path>
</svg>

<style>
  .emblem {
    width: 1em;
    height: 1em;
    display: block;
    flex: none;
  }

  polygon {
    fill: var(--creature-element);
    stroke: var(--creature-element-edge);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  path {
    fill: none;
    stroke: #fff;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
