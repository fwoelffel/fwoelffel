---
import CardBack from '../../components/card/Back.astro';
import { identity } from '../../config';
import Emblem from './Emblem.astro';
import './theme.css';
---

<CardBack>
  <div class='seal'>
    <span>{identity.initials}</span>
  </div>
  <Fragment slot='host'>
    <Emblem class='mark' />
    {identity.host}
    <Emblem class='mark' />
  </Fragment>
</CardBack>

<style>
  /* A hexagonal seal: a bright rim around a deep core holding the
     initials. Sizes are in its own em (3.4x the card's). */
  .seal {
    display: grid;
    place-items: center;
    width: 2.7em;
    height: 3.1em;
    font: 700 3.4em var(--display);
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    background: linear-gradient(160deg, #b8fff0, #12a58b 45%, #0b6b5e);
  }

  .seal span {
    display: grid;
    place-items: center;
    width: 2.35em;
    height: 2.7em;
    clip-path: inherit;
    background: radial-gradient(
      circle at 50% 35%,
      #3b2d8f,
      #16123f 70%,
      #0b0a24
    );
    color: #e9fff6;
    text-shadow: 0 0 0.25em rgb(120 255 220 / 0.6);
  }

  .mark {
    font-size: 1.1em;
  }
</style>
