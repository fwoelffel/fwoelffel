---
import CardBack from '../../components/card/Back.astro';
import { identity } from '../../config';
import './theme.css';
---

<CardBack>
  <div class='emblem'>{identity.initials}</div>
</CardBack>

<style>
  /* Sizes are in the emblem's own em (3.6x the card's): 2.5em = 9 card em. */
  .emblem {
    font: 700 3.6em var(--display);
    width: 2.5em;
    height: 2.5em;
    border-radius: 50%;
    display: grid;
    place-items: center;
    border: 0.08em solid var(--sport-gold-line);
    box-shadow:
      0 0 0.55em rgb(246 215 122 / 0.4),
      inset 0 0 0.42em rgb(246 215 122 / 0.25);
    background: radial-gradient(circle at 35% 30%, #4b63ff, #142070);
    color: var(--sport-cream);
  }
</style>
