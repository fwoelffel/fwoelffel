---
import Foil from '../../components/card/Foil.astro';
import Frame from '../../components/card/Frame.astro';
import Links from '../../components/card/Links.astro';
import Portrait from '../../components/card/Portrait.astro';
import { identity } from '../../config';
import { madeUp, type FrontProps } from '../types';
import duel from './index';
import './theme.css';

type Props = FrontProps;
const { number, eager } = Astro.props;
const stats = [
  ['Niv', duel.level],
  ['Atq', duel.attack],
  ['Déf', duel.defence],
] as const;
---

<Frame>
  <div class='inner'>
    <div class='bar'>
      <svg
        class='attribute'
        role='img'
        aria-label={`Attribut : ${duel.attribute}`}
        viewBox='0 0 24 24'>
        <circle cx='12' cy='12' r='11'></circle>
        <path d='M8.6 8 4.8 12l3.8 4M15.4 8l3.8 4-3.8 4M13.3 6.4l-2.6 11.2'></path>
      </svg>
      <h1>{identity.fullName}</h1>
    </div>
    <div class='art'>
      <Portrait class='photo' sizes='16rem' eager={eager} />
    </div>
    <div class='text'>
      <p class='role'>{identity.role}</p>
      <p class='effect'>{duel.effect}</p>
      <Links class='effects' inline />
      <p class='stats'>
        <span class='sr-only'>
          {`Niveau ${duel.level}, attaque ${duel.attack}, défense ${duel.defence} ${madeUp}`}
        </span>
        {stats.map(([name, value]) => (
          <b aria-hidden='true'>
            <small>{name}</small>
            {value}
          </b>
        ))}
      </p>
    </div>
    <div class='foot' aria-hidden='true'>
      <span>{number}</span>
      <span>{identity.host}</span>
    </div>
  </div>
  <Foil sweep />
</Frame>

<style>
  .inner {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.3em;
    padding: 0.4em 0.45em 0.25em;
    border-radius: 0.5em;
    background:
      radial-gradient(circle at 50% 30%, rgb(170 210 255 / 0.2), transparent),
      linear-gradient(170deg, #34424f, #151c23);
    box-shadow:
      inset 0.08em 0.08em 0 rgb(0 0 0 / 0.5),
      inset -0.08em -0.08em 0 rgb(255 255 255 / 0.3);
  }

  p,
  h1 {
    margin: 0;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.2em 0.5em 0.2em 0.25em;
    border-radius: 0.15em;
    background: var(--duel-paper);
    border: 0.1em solid var(--duel-steel-line);
    box-shadow: inset 0 -0.15em 0.3em rgb(40 60 80 / 0.3);
  }

  h1 {
    flex: 1;
    font: 700 1.35em/1 var(--display);
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  /* Attribute medallion: our own "</>" glyph on a steel disc. */
  .attribute {
    width: 1.7em;
    height: 1.7em;
    flex: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .attribute circle {
    fill: var(--duel-slate);
    stroke: var(--duel-steel-line);
    stroke-width: 1.5;
  }

  .attribute path {
    fill: none;
    stroke: var(--duel-pale);
    stroke-width: 2;
  }

  /* Square art window: as large as the room left allows. */
  .art {
    flex: 1 1 0;
    min-height: 4em;
    container-type: size;
  }

  .photo {
    height: 100%;
    --portrait-w: min(100cqw, 100cqh);
    --portrait-glow: 0 0 0 0.15em #151c23, 0 0 0 0.3em var(--duel-steel-line);
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 0.25em;
    padding: 0.3em 0.45em 0.2em;
    border-radius: 0.15em;
    background: var(--duel-paper);
    border: 0.1em solid var(--duel-steel-line);
    font-family: var(--duel-serif);
  }

  .role {
    font-size: 0.72em;
    font-weight: 700;
    font-variant: small-caps;
    letter-spacing: 0.04em;
  }

  .effect {
    font-size: 0.62em;
    line-height: 1.25;
  }

  /* The links read as effects: "GitHub : Mon code." */
  .effects :global(.link) {
    gap: 0.5em;
    padding-block: 0.2em;
  }

  .effects :global(b) {
    font: 700 0.95em var(--duel-serif);
    font-variant: small-caps;
  }

  .effects :global(small) {
    font-size: 0.75em;
    font-style: italic;
  }

  /* Level, attack and defence as three slate badges. */
  .stats {
    display: flex;
    justify-content: space-between;
    gap: 0.3em;
    padding-top: 0.2em;
    border-top: 1px solid rgb(40 60 80 / 0.4);
  }

  .stats b {
    display: flex;
    align-items: baseline;
    gap: 0.3em;
    padding: 0.1em 0.45em;
    border-radius: 0.2em;
    background: var(--duel-slate);
    color: var(--duel-pale);
    font: 700 0.78em var(--duel-serif);
    letter-spacing: 0.04em;
  }

  .stats small {
    font: 600 0.75em var(--display);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .foot {
    display: flex;
    justify-content: space-between;
    padding-inline: 0.3em;
    font: 600 0.55em var(--display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--duel-pale);
  }

  /* Text sits above the foil so the hotspot never washes it out. */
  .bar,
  .text,
  .foot {
    position: relative;
    z-index: 1;
  }

  /* Short landscape phones: the 44px links take most of a small card. */
  @media (orientation: landscape) and (max-height: 520px) {
    .inner,
    .text {
      gap: 0.15em;
    }

    .effect {
      display: none;
    }
  }
</style>
