---
import Foil from '../../components/card/Foil.astro';
import Frame from '../../components/card/Frame.astro';
import Links from '../../components/card/Links.astro';
import Portrait from '../../components/card/Portrait.astro';
import { identity } from '../../config';
import { madeUp, type FrontProps } from '../types';
import duel from './index';
import './theme.css';

type Props = FrontProps;
const { number, eager } = Astro.props;
---

<Frame>
  <div class='inner'>
    <div class='bar'>
      <h1>{identity.fullName}</h1>
      <svg
        class='attribute'
        role='img'
        aria-label={`Attribut : ${duel.attribute}`}
        viewBox='0 0 24 24'>
        <circle cx='12' cy='12' r='11'></circle>
        <path d='M8.6 8 4.8 12l3.8 4M15.4 8l3.8 4-3.8 4M13.3 6.4l-2.6 11.2'></path>
      </svg>
    </div>
    <p class='level' role='img' aria-label={`Niveau ${duel.level} ${madeUp}`}>
      {Array.from({ length: duel.level }, () => (
        <i />
      ))}
    </p>
    <div class='art'>
      <Portrait class='photo' sizes='16rem' eager={eager} />
    </div>
    <div class='text'>
      <p class='type'>[ {duel.type} ]</p>
      <p class='effect'>{duel.effect}</p>
      <Links class='effects' />
      <p class='stats'>
        <span aria-hidden='true'>
          ATQ/{duel.attack} DÉF/{duel.defence}
        </span>
        <span class='sr-only'>
          Attaque {duel.attack}, défense {duel.defence} {madeUp}
        </span>
      </p>
    </div>
    <div class='foot' aria-hidden='true'>
      <span>{number}</span>
      <span>{identity.host}</span>
    </div>
  </div>
  <Foil sweep />
</Frame>

<style>
  .inner {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.3em;
    padding: 0.4em 0.45em 0.25em;
    border-radius: 0.5em;
    background:
      radial-gradient(circle at 50% 30%, rgb(255 190 120 / 0.25), transparent),
      linear-gradient(170deg, #5a3520, #2b1a10);
    box-shadow:
      inset 0.08em 0.08em 0 rgb(0 0 0 / 0.5),
      inset -0.08em -0.08em 0 rgb(255 255 255 / 0.3);
  }

  p,
  h1 {
    margin: 0;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.2em 0.25em 0.2em 0.5em;
    border-radius: 0.15em;
    background: var(--duel-ivory);
    border: 0.1em solid var(--duel-copper-line);
    box-shadow: inset 0 -0.15em 0.3em rgb(110 58 25 / 0.3);
  }

  h1 {
    flex: 1;
    font: 700 1.35em/1 var(--display);
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  /* Attribute medallion: our own "</>" glyph on a copper disc. */
  .attribute {
    width: 1.7em;
    height: 1.7em;
    flex: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .attribute circle {
    fill: #6e3a19;
    stroke: var(--duel-copper-line);
    stroke-width: 1.5;
  }

  .attribute path {
    fill: none;
    stroke: var(--duel-pale);
    stroke-width: 2;
  }

  /* Level: four-point sparkles, right-aligned. */
  .level {
    display: flex;
    justify-content: flex-end;
    gap: 0.2em;
    padding-right: 0.3em;
  }

  .level i {
    width: 0.95em;
    height: 0.95em;
    clip-path: polygon(
      50% 0,
      62% 38%,
      100% 50%,
      62% 62%,
      50% 100%,
      38% 62%,
      0 50%,
      38% 38%
    );
    background: linear-gradient(#ffe7b0, #d98b3a);
  }

  /* Square art window: as large as the room left allows. */
  .art {
    flex: 1 1 0;
    min-height: 4em;
    container-type: size;
  }

  .photo {
    height: 100%;
    --portrait-w: min(100cqw, 100cqh);
    --portrait-glow: 0 0 0 0.15em #2b1a10, 0 0 0 0.3em var(--duel-copper-line);
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 0.25em;
    padding: 0.3em 0.45em 0.2em;
    border-radius: 0.15em;
    background: var(--duel-ivory);
    border: 0.1em solid var(--duel-copper-line);
    font-family: var(--duel-serif);
  }

  .type {
    font-size: 0.72em;
    font-weight: 700;
    font-variant: small-caps;
    letter-spacing: 0.04em;
  }

  .effect {
    font-size: 0.62em;
    line-height: 1.25;
  }

  /* The links read as effects: "GitHub : Mon code." */
  .effects :global(.link) {
    gap: 0.5em;
    padding-block: 0.2em;
  }

  .effects :global(a > span:first-of-type) {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.35em;
  }

  .effects :global(b) {
    font: 700 0.95em var(--duel-serif);
    font-variant: small-caps;
    text-transform: none;
  }

  .effects :global(b)::after {
    content: ' :' / '';
  }

  .effects :global(small) {
    font-size: 0.75em;
    font-style: italic;
    opacity: 1;
  }

  .effects :global(small)::after {
    content: '.' / '';
  }

  .stats {
    padding-top: 0.15em;
    border-top: 1px solid rgb(110 58 25 / 0.5);
    text-align: right;
    font: 700 0.78em var(--duel-serif);
    letter-spacing: 0.06em;
  }

  .foot {
    display: flex;
    justify-content: space-between;
    padding-inline: 0.3em;
    font: 600 0.55em var(--display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--duel-pale);
  }

  /* Text sits above the foil so the hotspot never washes it out. */
  .bar,
  .text,
  .foot {
    position: relative;
    z-index: 1;
  }

  /* Short landscape phones: the 44px links take most of a small card. */
  @media (orientation: landscape) and (max-height: 520px) {
    .inner,
    .text {
      gap: 0.15em;
    }

    .effect {
      display: none;
    }
  }
</style>
