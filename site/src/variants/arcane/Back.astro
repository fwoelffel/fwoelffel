---
import Foil from '../../components/card/Foil.astro';
import Frame from '../../components/card/Frame.astro';
import { identity } from '../../config';
import './theme.css';
---

<Frame>
  <div class='inner'>
    <div class='sigil'>
      <i></i>
      <i></i>
      <b>{identity.initials}</b>
    </div>
    <p>{identity.host}</p>
    <Foil />
  </div>
</Frame>

<style>
  .inner {
    position: relative;
    height: 100%;
    border-radius: 0.6em;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.6em;
    background:
      radial-gradient(circle, transparent 30%, rgb(8 6 14 / 0.75) 85%),
      conic-gradient(
        from 20deg,
        #3b2463,
        #173946,
        #4a2559,
        #13283d,
        #2f2a62,
        #3b2463
      );
  }

  /* A swirling seal: two gilt rings, a ring of rune ticks, an eight-point
     star made of two squares, the initials in the middle. */
  .sigil {
    position: relative;
    width: 14em;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: radial-gradient(
      circle closest-side,
      rgb(255 225 150 / 0.12) 0 42%,
      transparent 42% 74%,
      var(--arcane-gold-line) 74% 75.5%,
      transparent 75.5% 96%,
      var(--arcane-gold-line) 96% 98%,
      transparent 98%
    );
  }

  .sigil::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: repeating-conic-gradient(
      var(--arcane-gold-line) 0 3deg,
      transparent 3deg 15deg
    );
    mask: radial-gradient(
      circle closest-side,
      transparent 80%,
      #000 80% 91%,
      transparent 91%
    );
  }

  .sigil i {
    position: absolute;
    inset: 24%;
    border: 0.12em solid var(--arcane-gold-line);
    box-shadow: 0 0 0.8em rgb(217 180 106 / 0.35);
  }

  .sigil i + i {
    rotate: 45deg;
  }

  .sigil b {
    position: relative;
    font: 700 3.4em var(--display);
    letter-spacing: 0.04em;
    background: var(--arcane-gold);
    background-clip: text;
    color: transparent;
  }

  p {
    margin: 0;
    font: 600 1em var(--display);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--arcane-pale);
  }
</style>
