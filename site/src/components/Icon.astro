---
import github from '@phosphor-icons/core/assets/bold/github-logo-bold.svg?raw';
import linkedin from '@phosphor-icons/core/assets/bold/linkedin-logo-bold.svg?raw';
import rss from '@phosphor-icons/core/assets/bold/rss-simple-bold.svg?raw';
import mail from '@phosphor-icons/core/assets/bold/envelope-simple-bold.svg?raw';
import arrow from '@phosphor-icons/core/assets/bold/arrow-up-right-bold.svg?raw';
import type { IconName } from '../config';

interface Props {
  name: IconName | 'arrow';
}

const sources: Record<Props['name'], string> = {
  github,
  linkedin,
  rss,
  mail,
  arrow,
};
// Inlined at build time: no icon font, no extra request.
const svg = sources[Astro.props.name].replace(
  '<svg ',
  '<svg aria-hidden="true" focusable="false" width="1em" height="1em" ',
);
---

<Fragment set:html={svg} />
