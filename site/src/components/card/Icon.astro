---
import type { IconName } from '../../config';

interface Props {
  name: IconName | 'arrow';
}
// Points at the shared sprite (IconSprite.astro): one copy of each path.
---

<svg aria-hidden='true' width='1em' height='1em' fill='currentColor'>
  <use href={`#icon-${Astro.props.name}`}></use>
</svg>
