---
/**
 * The visible card body: fills a face, rounds and clips it, casts the
 * shadow. Variants theme it with `--frame-bg`, `--frame-padding`
 * and `--frame-ink` (text colour).
 */
---

<div class='frame'>
  <slot />
</div>

<style>
  .frame {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: 1.15em;
    padding: var(--frame-padding, 0.65em);
    background: var(--frame-bg, #8a8fa8);
    box-shadow: 0 2em 3.5em -1.2em rgb(0 0 0 / 0.6);
    color: var(--frame-ink, #fff);
  }
</style>
