---
/**
 * Every registered variant's card, stacked in the same place, plus the
 * style switcher: a radio group shown as a small segmented control under
 * the card on mouse/trackpad devices, and position dots on touch screens
 * (where a horizontal swipe switches; the radios stay available to screen
 * readers). Without JavaScript only the default card shows and the
 * switcher stays hidden. Behaviour: src/scripts/deck.ts.
 *
 * On arrival (JavaScript on, motion allowed), a sealed pack opens and the
 * real cards fan out of it, then gather with the active card in front:
 * `data-pack` on the deck, set by the inline script, removed by deck.ts.
 */
import Card from './card/Card.astro';
import { identity } from '../config';
import { collectorNumber, variants } from '../variants';

const many = variants.length > 1;
---

<div class:list={['deck', { many }]} data-deck>
  <script is:inline>
    // Before the cards paint: a shared #id link waits for deck.ts to show
    // the right card instead of flashing the default one. The pack opens
    // on arrival only: inline scripts do not rerun on a back/forward restore.
    const deck = document.currentScript.parentElement;
    deck.dataset.js = location.hash.length > 1 ? 'pending' : 'ready';
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
      deck.dataset.pack = '';
  </script>
  <div class='stack'>
    {variants.map(({ id, Front, Back }, i) => (
      <div
        class='slot'
        data-slot={id}
        style={`--f: ${i - (variants.length - 1) / 2}`}
        hidden={i > 0}
        inert={i > 0}
        aria-hidden={i > 0 ? 'true' : undefined}>
        <Card
          variant={id}
          label={`Carte de ${identity.fullName}`}
          intro={i === 0}>
          <Front
            slot='front'
            number={collectorNumber(i, variants.length)}
            eager={i === 0}
          />
          <Back slot='back' />
        </Card>
      </div>
    ))}
    <div class='pack' aria-hidden='true'>
      <div class='pack-top'></div>
      <div class='pack-body'>
        <b>{identity.initials}</b>
        <span>{identity.host}</span>
        <small>Édition holo</small>
      </div>
    </div>
  </div>
  {many && (
    <>
      <fieldset class='switcher'>
        <legend class='sr-only'>Style de carte</legend>
        {variants.map(({ id, label }, i) => (
          <label>
            <input
              type='radio'
              name='card-style'
              value={id}
              checked={i === 0}
            />
            <span>{label}</span>
          </label>
        ))}
      </fieldset>
      <ol class='dots' aria-hidden='true'>
        {variants.map(({ id }, i) => (
          <li data-dot={id} class:list={{ 'is-active': i === 0 }} />
        ))}
      </ol>
    </>
  )}
</div>

<style>
  .deck {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Room under the card for the switcher (read by the card's sizing). */
  .deck.many[data-js] {
    gap: 0.5rem;
    --card-reserve: 1rem;
  }

  .stack {
    display: grid;
  }

  .slot {
    grid-area: 1 / 1;
    perspective: 1100px;
  }

  /* Next (step 1): the card leaves to the left, the new one comes from the
     right; previous (step -1): the other way round. */
  .slot.is-entering {
    z-index: 1;
    animation: deck-enter 0.4s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .slot.is-leaving {
    animation: deck-leave 0.4s cubic-bezier(0.4, 0, 0.7, 0.4) both;
  }

  @keyframes deck-enter {
    from {
      opacity: 0;
      transform: translateX(calc(var(--step) * 65%))
        rotate(calc(var(--step) * 7deg));
    }
  }

  @keyframes deck-leave {
    to {
      opacity: 0;
      transform: translateX(calc(var(--step) * -65%))
        rotate(calc(var(--step) * -7deg));
    }
  }

  /* Shared link: keep the cards hidden until the right one is shown (with
     a 1s failsafe should the script never run). */
  .deck[data-js='pending'] .stack {
    animation: deck-wait 1s step-end;
  }

  @keyframes deck-wait {
    from {
      visibility: hidden;
    }
  }

  /* ---- Opening pack (2.5s) --------------------------------------------
     The pack pops in, its crimped top peels off and light pours out of
     the widening slit, growing until the strip is gone; the pack is
     pulled down while the cards (every slot, f = position from the
     middle) slide up out of it through the light to a short apex, fan
     out around their bottom edge with a foil sweep, then gather: the
     active card ends in front, the others fade out. Only transforms,
     opacity and custom properties. The cards stay opaque behind the
     pack, so the default card's photo paints (LCP) at once. */
  .pack {
    display: none;
    grid-area: 1 / 1;
    z-index: 3;
    position: relative;
    margin: -6% -4%;
    container-type: inline-size;
    pointer-events: none;
  }

  .pack-top,
  .pack-body {
    position: absolute;
    inset: 0;
    --teeth: conic-gradient(
        from var(--a) at 50% var(--y),
        #0000,
        #000 1deg 89deg,
        #0000 90deg
      )
      50% var(--y) / 4cqi 51% repeat-x;
  }

  /* Crimped band with a zigzag top edge and a dashed tear line. */
  .pack-top {
    bottom: auto;
    height: 14%;
    --a: 135deg;
    --y: 0%;
    mask:
      var(--teeth),
      linear-gradient(#000 0 0) 0 100% / 100% 51% no-repeat;
    background:
      repeating-linear-gradient(
        90deg,
        rgb(255 255 255 / 0.3) 0 0.6cqi,
        rgb(0 0 0 / 0.15) 0.6cqi 1.6cqi
      ),
      linear-gradient(#8a93d8, #3b3f86);
    border-bottom: 0.5cqi dashed rgb(255 255 255 / 0.7);
    transform-origin: 100% 100%;
  }

  .pack-body {
    top: 14%;
    background:
      repeating-linear-gradient(
        60deg,
        rgb(255 255 255 / 0.07) 0 1px,
        transparent 1px 7cqi
      ),
      repeating-linear-gradient(
        -60deg,
        rgb(255 255 255 / 0.07) 0 1px,
        transparent 1px 7cqi
      ),
      linear-gradient(
        160deg,
        #1d2160,
        #5b34b0 35%,
        #1b7fa8 62%,
        #c0478f 85%,
        #1d2160
      );
    --a: -45deg;
    --y: 100%;
    mask:
      var(--teeth),
      linear-gradient(#000 0 0) 0 0 / 100% 51% no-repeat;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3cqi;
    padding-bottom: 8%;
    color: #fff;
    font-family: var(--display);
    text-transform: uppercase;
    text-align: center;
  }

  .pack-body b {
    font-size: 34cqi;
    line-height: 0.8;
    letter-spacing: 0.04em;
    text-shadow:
      0 0 4cqi rgb(120 200 255 / 0.8),
      0.6cqi 0.6cqi 0 #c0478f;
  }

  .pack-body span {
    font-size: 7cqi;
    letter-spacing: 0.18em;
  }

  .pack-body small {
    padding: 1cqi 3cqi;
    border: 0.4cqi solid;
    border-radius: 99px;
    font-size: 4.5cqi;
    letter-spacing: 0.3em;
  }

  /* Light spilling out of the slit as the top peels off: on the body's
     edge and under the strip. */
  .pack-top::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 45%;
    opacity: 0;
    background: linear-gradient(transparent, rgb(255 236 190 / 0.9));
  }

  .pack-body::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 22%;
    opacity: 0;
    background: linear-gradient(
      rgb(255 246 220 / 0.95),
      rgb(255 214 140 / 0.35) 40%,
      transparent
    );
  }

  /* A glint crossing the foil. */
  .pack-body::after {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0;
    background: linear-gradient(
      105deg,
      transparent 35%,
      rgb(255 255 255 / 0.45) 50%,
      transparent 65%
    );
  }

  /* The light behind the cards: a glow (::after) and slowly turning rays
     (::before), the size of the pack, never scaled past it (no overflow;
     they only leave the box upwards, which never scrolls). */
  @property --pack-ray {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  @media (prefers-reduced-motion: no-preference) {
    .deck[data-pack] .pack {
      display: block;
      transform-origin: 50% 100%;
      animation:
        pack-open 2.5s both,
        pack-wobble 1.3s 0.5s ease-in-out;
    }

    .deck[data-pack] .pack-top {
      animation: pack-tear 0.65s 0.55s both;
    }

    .deck[data-pack] .pack-top::after,
    .deck[data-pack] .pack-body::before {
      animation: pack-slit 0.5s 0.6s both;
    }

    .deck[data-pack] .pack-body::after {
      animation: pack-glint 0.7s 0.15s ease-out;
    }

    .deck[data-pack] .stack::before,
    .deck[data-pack] .stack::after {
      content: '';
      grid-area: 1 / 1;
      margin: -6% -4%;
      pointer-events: none;
      opacity: 0;
    }

    .deck[data-pack] .stack::before {
      background: repeating-conic-gradient(
        from var(--pack-ray),
        rgb(255 236 190 / 0.5) 0 2.5deg,
        transparent 2.5deg 11deg
      );
      mask: radial-gradient(closest-side, #000 15%, transparent);
      animation: pack-rays 2.5s both;
    }

    .deck[data-pack] .stack::after {
      background: radial-gradient(
        closest-side,
        rgb(255 252 240),
        rgb(255 214 130 / 0.7) 30%,
        rgb(255 170 90 / 0.25) 60%,
        transparent
      );
      animation: pack-glow 2.5s both;
    }

    /* The pack falls below the fold: no scrollbar meanwhile. */
    :global(main:has(> .deck[data-pack])) {
      overflow: clip;
    }

    /* Every card is painted while the pack is open, hidden ones too, in
       front of the light and behind the pack. */
    .deck[data-pack] .slot {
      --fan: 1;
      display: block;
      z-index: 1;
      transform-origin: 50% 100%;
      animation: pack-fan 2.5s both;
    }

    /* Portrait phones, narrow windows: a tighter fan that stays on screen. */
    @media (max-aspect-ratio: 4 / 5), (max-width: 37.5rem) {
      .deck[data-pack] .slot {
        --fan: 0.52;
      }
    }

    .deck[data-pack] .slot:not([inert]) {
      z-index: 2;
    }

    .deck[data-pack] .slot[inert] {
      --pack-o: 0;
    }
  }

  @keyframes pack-open {
    0% {
      scale: 0.92;
      translate: 0 4%;
      animation-timing-function: cubic-bezier(0.3, 1.6, 0.5, 1);
    }
    14%,
    26% {
      scale: 1;
      translate: 0;
      animation-timing-function: cubic-bezier(0.4, 0, 0.6, 1);
    }
    /* Swells as the light builds up inside, then settles. */
    36% {
      scale: 1.025;
      translate: 0;
      animation-timing-function: cubic-bezier(0.4, 0, 0.6, 1);
    }
    /* Pulled down, still opaque, while the cards slide up out of it: the
       slit moves below them. Then it falls away and fades. */
    40% {
      scale: 1;
      translate: 0;
      opacity: 1;
      animation-timing-function: cubic-bezier(0.4, 0, 0.3, 1);
    }
    58% {
      translate: 0 50%;
      opacity: 1;
      animation-timing-function: ease-in;
    }
    66%,
    100% {
      scale: 1;
      translate: 0 62%;
      opacity: 0;
    }
  }

  /* A soft foil strip, not a rigid lid: it stretches under the tug,
     bends back in 3D as it peels from the left (the slit opens and lets
     the light out), snaps free with a little overshoot, then flies off
     curling. Same function list in every stop so they interpolate. */
  @keyframes pack-tear {
    0% {
      transform: perspective(60cqi) translateY(0) rotate(0) rotateX(0) skewX(0)
        scaleY(1);
      animation-timing-function: cubic-bezier(0.4, 0, 0.6, 1);
    }
    18% {
      transform: perspective(60cqi) translateY(-4%) rotate(2deg) rotateX(0)
        skewX(4deg) scaleY(1.12);
      animation-timing-function: cubic-bezier(0.3, 0, 0.5, 1);
    }
    40% {
      transform: perspective(60cqi) translateY(-14%) rotate(-5deg)
        rotateX(28deg) skewX(-6deg) scaleY(1.05);
      animation-timing-function: cubic-bezier(0.4, 0, 0.5, 1);
    }
    55% {
      transform: perspective(60cqi) translateY(-28%) rotate(-11deg)
        rotateX(40deg) skewX(-10deg) scaleY(0.95);
      opacity: 1;
      animation-timing-function: cubic-bezier(0.3, 0.6, 0.4, 1);
    }
    to {
      opacity: 0;
      transform: perspective(60cqi) translateY(-170%) rotate(-22deg)
        rotateX(65deg) skewX(-4deg) scaleY(0.9);
    }
  }

  /* The pack gives a little under the pull, then springs back once the
     strip snaps free (a damped wobble around its bottom edge). */
  @keyframes pack-wobble {
    10% {
      transform: skewX(-1deg) scaleY(1.012);
    }
    32% {
      transform: rotate(-1deg) skewX(-2.5deg) scaleY(1.02);
    }
    46% {
      transform: rotate(0.9deg) skewX(2deg) scaleY(0.985);
    }
    60% {
      transform: rotate(-0.45deg) skewX(-1deg) scaleY(1.008);
    }
    74% {
      transform: rotate(0.2deg) skewX(0.4deg) scaleY(0.997);
    }
    88% {
      transform: rotate(-0.06deg) skewX(-0.12deg);
    }
  }

  @keyframes pack-slit {
    25% {
      opacity: 0.3;
      animation-timing-function: ease-in;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes pack-glint {
    from {
      opacity: 1;
      translate: -100% 0;
    }
    to {
      opacity: 1;
      translate: 100% 0;
    }
  }

  /* Glow and rays start as a spark at the slit (the box centre, moved up)
     and grow with the peel, accelerating to a peak at ~1.05s, just before
     the strip is gone (1.2s); they hold until the cards' apex (1.45s, 58%),
     then follow them down and fade. */
  @keyframes pack-glow {
    0%,
    24% {
      opacity: 0;
      transform: translateY(-40%) scale(0.05);
      animation-timing-function: cubic-bezier(0.5, 0, 0.8, 0.6);
    }
    42% {
      opacity: 1;
      transform: translateY(-37%) scale(0.85);
      animation-timing-function: ease-out;
    }
    58% {
      opacity: 0.95;
      transform: translateY(-37%) scale(1);
      animation-timing-function: cubic-bezier(0.4, 0, 0.6, 1);
    }
    66% {
      opacity: 0.8;
      transform: translateY(-14%) scale(1);
      animation-timing-function: ease-in;
    }
    84%,
    100% {
      opacity: 0;
      transform: translateY(-10%) scale(1);
    }
  }

  @keyframes pack-rays {
    0%,
    26% {
      opacity: 0;
      transform: translateY(-40%) scale(0.05);
      animation-timing-function: cubic-bezier(0.5, 0, 0.8, 0.6);
    }
    42% {
      opacity: 0.9;
      transform: translateY(-37%) scale(0.95);
      animation-timing-function: ease-out;
    }
    58% {
      opacity: 0.8;
      transform: translateY(-37%) scale(1);
      animation-timing-function: cubic-bezier(0.4, 0, 0.6, 1);
    }
    66% {
      opacity: 0.6;
      transform: translateY(-14%) scale(1);
      animation-timing-function: ease-in;
    }
    80%,
    100% {
      opacity: 0;
      transform: translateY(-10%) scale(1);
      --pack-ray: 50deg;
    }
  }

  /* Slide up out of the pack to a short apex, settle into the fan, a slow
     lift while fanned, then the gather. */
  @keyframes pack-fan {
    0%,
    38% {
      transform: translateY(-8%) scale(0.76);
      animation-timing-function: cubic-bezier(0.45, 0, 0.4, 1);
    }
    /* Out of the top of the pack, as it is pulled down. */
    58% {
      transform: translate(0, -38%) rotate(calc(var(--f) * 2.5deg)) scale(0.66);
      animation-timing-function: cubic-bezier(0.4, 0, 0.3, 1);
    }
    72% {
      transform: translate(
          calc(var(--f) * 11% * var(--fan)),
          calc((0.55 * var(--fan) - 1) * 50%)
        )
        rotate(calc(var(--f) * 9deg)) scale(calc(0.55 * var(--fan)));
      opacity: 1;
      animation-timing-function: linear;
    }
    80% {
      transform: translate(
          calc(var(--f) * 11% * var(--fan)),
          calc((0.55 * var(--fan) - 1) * 50% - 2%)
        )
        rotate(calc(var(--f) * 9deg)) scale(calc(0.55 * var(--fan)));
      opacity: 1;
      animation-timing-function: cubic-bezier(0.55, 0, 0.25, 1);
    }
    100% {
      transform: none;
      opacity: var(--pack-o, 1);
    }
  }

  .switcher,
  .dots {
    display: none;
    margin: 0;
    padding: 0;
  }

  /* The style selector: a small segmented control. */
  .many[data-js] .switcher {
    display: flex;
    gap: 0.15rem;
    padding: 0.2rem;
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  /* Touch screens: dots show the position instead. */
  .many[data-js] .dots {
    display: flex;
    gap: 0.5rem;
    height: 0.5rem;
    align-items: center;
    list-style: none;
  }

  .dots li {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--line);
    transition:
      background-color 0.3s,
      scale 0.3s;
  }

  .dots li.is-active {
    background: var(--ink);
    scale: 1.3;
  }

  /* Mouse or trackpad: the segmented control instead of the dots. */
  @media (hover: hover) and (pointer: fine) {
    .deck.many[data-js] {
      gap: 0.75rem;
      --card-reserve: 3rem;
    }

    .many[data-js] .dots {
      display: none;
    }
  }

  /* Touch screens: the radios stay for screen readers, visually hidden,
     until they hold keyboard focus (a tablet with a keyboard): then the
     segmented control shows in place of the dots. */
  @media not all and (hover: hover) and (pointer: fine) {
    .many[data-js] .switcher:not(:has(:focus-visible)) {
      position: absolute;
      width: 1px;
      min-inline-size: 0; /* a fieldset is at least min-content wide */
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
      border: 0;
    }

    .many[data-js]:has(.switcher :focus-visible) .dots {
      display: none;
    }
  }

  .switcher label {
    position: relative;
    display: block;
  }

  .switcher input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .switcher span {
    display: block;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    font: 600 0.85rem / 1.2 var(--display);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .switcher input:hover + span {
    background: var(--line);
  }

  .switcher input:checked + span {
    background: var(--ink);
    color: var(--s2);
  }

  .switcher input:focus-visible + span {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .slot.is-entering,
    .slot.is-leaving {
      animation: none;
    }
  }
</style>

<script>
  import { mountDeck } from '../scripts/deck';
  mountDeck();
</script>
